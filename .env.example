# Twitch Developer application Client ID.
TWITCH_CLIENT_ID=your_client_id

# OAuth token with chat:read and chat:edit scopes. Use the token without oauth: too.
TWITCH_OAUTH_TOKEN=your_oauth_token
TWITCH_BOT_USERNAME=your_bot_login
TWITCH_CHANNEL=channel_to_watch

# YES/ДА: send messages continuously, including while the channel is offline.
# NO/НЕТ: connect and send only while the channel is live.
TWITCH_CHAT_SEND_ALWAYS=NO

# Wait this long before each cycle; messages inside a cycle are sent consecutively.
TWITCH_MESSAGE_INTERVAL=60
TWITCH_STATUS_CHECK_INTERVAL=30
TWITCH_RECONNECT_DELAY=5
TWITCH_MESSAGES_FILE=messages.txt
TWITCH_LOG_LEVEL=INFO